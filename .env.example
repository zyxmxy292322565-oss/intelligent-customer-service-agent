# 本地开发：复制为 .env；生产环境优先通过部署系统注入同名环境变量。
APP_ENV=development
USE_LANGGRAPH_AGENT=false
LOG_LEVEL=INFO
JWT_SECRET_KEY=local-dev-jwt-key
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
# 客服工作台单独凭证。保持空值时管理员接口关闭；生产环境请设置至少 32 位随机值。
ADMIN_API_KEY=

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=consumer_service_agent
MYSQL_CONNECT_TIMEOUT=3

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=local-dev-redis-only-change-me
REDIS_SOCKET_TIMEOUT=2
REDIS_KEY_PREFIX=consumer_agent
REDIS_RATE_LIMIT_TTL_SECONDS=600
AGENT_GLOBAL_CAPACITY=100
AGENT_GLOBAL_RATE=20
AGENT_USER_CAPACITY=5
AGENT_USER_RATE=1

# Agent Task 数据库租约与有界恢复。心跳间隔必须显著短于租约。
TASK_LEASE_SECONDS=60
TASK_HEARTBEAT_INTERVAL_SECONDS=10
TASK_RECOVERY_SCAN_INTERVAL_SECONDS=30
TASK_RECOVERY_BATCH_SIZE=20
TASK_RECOVERY_CLAIM_SECONDS=60

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# demo3_rag_qa 使用 DEEPSEEK_API_BASE；与上面的后端地址保持一致。
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 本机直连独立 RAG 服务时使用此地址；Compose 中 backend 固定使用 http://policy-rag:8000。
POLICY_RAG_SERVICE_URL=http://127.0.0.1:8001
POLICY_RAG_TIMEOUT_SECONDS=8

# Docker Compose 专用开发示例值；生产环境必须替换，不能使用下列公开密码。
MYSQL_ROOT_PASSWORD=local-dev-root-only-change-me
MYSQL_APP_USER=agent
MYSQL_APP_PASSWORD=local-dev-app-only-change-me
# RAG 使用单独的 rag_demo 数据库和账号；生产环境必须更换示例密码。
RAG_MYSQL_USER=rag_agent
RAG_MYSQL_PASSWORD=local-dev-rag-only-change-me
RAG_REDIS_DB=1
APP_PORT=8000
FRONTEND_PORT=8501
ADMIN_FRONTEND_PORT=8502

# 可选：Trace 页仅使用独立 SELECT 权限账号；留空时页面显示配置提示。
TRACE_DB_USER=
TRACE_DB_PASSWORD=
